# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Pixel (client-side)
VITE_META_PIXEL_ID=

# Customer-facing site origin (no trailing slash), e.g. https://leanandfit.ph
# Used to build partner referral links (leanandfit.ph/{code}) so they're
# correct even when built from inside the admin/partner subdomain. Optional -
# without it, buildReferralUrl() falls back to stripping a known admin/
# partner subdomain prefix off the current hostname.
VITE_SITE_URL=

# --- Server-only secrets (Supabase Edge Functions, never exposed to the client) ---
# Set these with: supabase secrets set KEY=value
RESEND_API_KEY=
EMAIL_FROM="Lean & Fit <no-reply@leanandfit.ph>"
BUSINESS_NOTIFICATION_EMAIL=
META_CAPI_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# Ganap payment gateway (GCash/Maya/Online Banking on retail checkout - see
# supabase/functions/ganap-checkout|ganap-webhook|ganap-check-status and
# supabase/README.md's Ganap section for the full setup, including the
# webhook URL to configure in the Ganap dashboard).
GANAP_PROJECT_UUID=
GANAP_SIGNING_SECRET=
# Public marketing site origin, no trailing slash, e.g. https://leanandfit.ph
# - used to build the page Ganap sends the customer back to after payment.
SITE_URL=
