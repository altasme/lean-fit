# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Pixel (client-side)
VITE_META_PIXEL_ID=

# Customer-facing site origin (no trailing slash), e.g. https://leanandfit.ph
# Used to build partner referral links (leanandfit.ph/{code}) so they're
# correct even when built from inside the admin/partner subdomain. Optional -
# without it, buildReferralUrl() falls back to stripping a known admin/
# partner subdomain prefix off the current hostname.
VITE_SITE_URL=

# --- Server-only secrets (Supabase Edge Functions, never exposed to the client) ---
# Set these with: supabase secrets set KEY=value
RESEND_API_KEY=
BUSINESS_NOTIFICATION_EMAIL=
META_CAPI_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
