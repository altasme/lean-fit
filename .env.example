# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Pixel (client-side)
VITE_META_PIXEL_ID=

# Customer-facing site origin (no trailing slash), e.g. https://leanandfit.ph
# Used to build partner referral links (leanandfit.ph/{code}) so they're
# correct even when built from inside the admin/partner subdomain. Optional -
# without it, buildReferralUrl() falls back to stripping a known admin/
# partner subdomain prefix off the current hostname.
VITE_SITE_URL=

# --- Server-only secrets (Supabase Edge Functions, never exposed to the client) ---
# Set these with: supabase secrets set KEY=value
RESEND_API_KEY=
EMAIL_FROM="Lean & Fit <no-reply@leanandfit.ph>"
META_CAPI_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# Ganap payment gateway (GCash/Maya/Online Banking on retail checkout - see
# supabase/functions/ganap-checkout|ganap-webhook|ganap-check-status and
# supabase/README.md's Ganap section for the full setup, including the
# webhook URL to configure in the Ganap dashboard).
GANAP_PROJECT_UUID=
GANAP_SIGNING_SECRET=
# Public marketing site origin, no trailing slash, e.g. https://leanandfit.ph
# - used to build the page Ganap sends the customer back to after payment.
SITE_URL=

# Cloudflare Turnstile - captcha shown before a Cash on Delivery order can
# be submitted at retail checkout (client request: protect against spam
# orders - see src/components/checkout/Turnstile.tsx and
# supabase/functions/submit-cod-order). Get both keys free from the
# Cloudflare dashboard -> Turnstile (same account this site's already
# hosted on) -> Add a site. VITE_TURNSTILE_SITE_KEY is public/safe in the
# client bundle; TURNSTILE_SECRET_KEY is server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Discord notifications (client request - see supabase/README.md's Discord
# section for the full setup, including the weekly report's pg_cron
# schedule). Each is a separate Discord channel's Incoming Webhook URL
# (Discord: channel settings -> Integrations -> Webhooks) - all three are
# independent, set only the ones you actually want notifications in.
DISCORD_ORDERS_WEBHOOK_URL=
DISCORD_PARTNERS_WEBHOOK_URL=
DISCORD_REPORTS_WEBHOOK_URL=
